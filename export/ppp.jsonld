    "fr": "Ce que la mesure ne saisit pas (observateur, lumière, distance, contexte…).",
    "en": "What the measurement does not capture (observer, lighting, distance, context…)."
   },
   "rdfs_domain": "ppp:AssociatedMeasure",
   "rdfs_range": "rdf:langString"
  },
  {
