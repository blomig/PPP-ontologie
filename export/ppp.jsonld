  {
   "@id": "ppp:regionOf",
   "@type": "owl:ObjectProperty",
   "rdfs_subPropertyOf": "skos:broader",
   "rdfs_label": {
    "fr": "région de",
    "en": "region of"
   },
   "rdfs_comment": {
    "fr": "Relie une région à son type : région de l’espace de valeurs de ce type, pas une sous-espèce.",
    "en": "Links a region to its type: a region of the value space of that type, not a subtype."
   },
   "scopeNote": {
    "fr": "région de l’espace de valeurs de ce type, pas une sous-espèce",
    "en": "region of the value space of this type, not a subtype"
   },
   "rdfs_domain": "skos:Concept",
   "rdfs_range": "skos:Concept"
  },
  {
   "@id": "ppp:hasScale",
   "@type": "owl:ObjectProperty",
   "rdfs_label": {
    "fr": "a pour échelle",
    "en": "has scale"
   },
   "rdfs_comment": {
    "fr": "Relie un type à la collection de ses régions (son échelle) : ordonnée si l’échelle est ordinale.",
    "en": "Links a type to the collection of its regions (its scale): ordered if the scale is ordinal."
   },
   "rdfs_domain": "skos:Concept",
   "rdfs_range": "skos:Collection"
  },
  {
   "@id": "ppp:AssociatedMeasure",
   "@type": "owl:Class",
   "rdfs_label": {
    "fr": "mesure associée",
    "en": "associated measurement"
   },
   "rdfs_comment": {
    "fr": "Méthode de mesure instrumentale associée à un type : elle peut éclairer une observation, mais ne définit pas les bornes des régions.",
    "en": "Instrumental measurement method associated with a type: it can inform an observation, but does not define the region boundaries."
   }
  },
  {
   "@id": "ppp:NotRetainedMeasure",
   "@type": "owl:Class",
   "rdfs_label": {
    "fr": "mesure non retenue",
    "en": "measurement not retained"
   },
   "rdfs_comment": {
    "fr": "Méthode examinée et non retenue comme mesure associée, avec la raison.",
    "en": "Method examined and not retained as an associated measurement, with the reason."
   }
  },
  {
   "@id": "ppp:MeasurementState",
   "@type": "owl:Class",
   "rdfs_label": {
    "fr": "état de la rubrique mesure",
    "en": "state of the measurement section"
   },
   "rdfs_comment": {
    "fr": "Valeur de l’état de la rubrique mesure : méthodes connues, ou aucune méthode robuste.",
    "en": "Value of the measurement section state: known methods, or no robust method."
   }
  },
  {
   "@id": "ppp:Proximity",
   "@type": "owl:Class",
   "rdfs_label": {
    "fr": "proximité d’une mesure",
    "en": "closeness of a measurement"
   },
   "rdfs_comment": {
    "fr": "Proximité d’une mesure associée au type : proche ou indirecte (jamais identique).",
    "en": "Closeness of an associated measurement to the type: close or indirect (never identical)."
   }
  },
  {
   "@id": "ppp:measurementState",
   "@type": "owl:ObjectProperty",
   "rdfs_label": {
    "fr": "état de la mesure",
    "en": "measurement state"
   },
   "rdfs_comment": {
    "fr": "État de la rubrique mesure du type.",
    "en": "State of the type’s measurement section."
   },
   "rdfs_domain": "skos:Concept",
   "rdfs_range": "ppp:MeasurementState"
  },
  {
   "@id": "ppp:measurementSummary",
   "@type": "owl:DatatypeProperty",
   "rdfs_subPropertyOf": "skos:note",
   "rdfs_label": {
    "fr": "synthèse de la mesure",
    "en": "measurement summary"
   },
   "rdfs_comment": {
    "fr": "Synthèse de la rubrique mesure du type.",
    "en": "Summary of the type’s measurement section."
   },
   "rdfs_domain": "skos:Concept",
   "rdfs_range": "rdf:langString"
  },
  {
   "@id": "ppp:measurementCaveat",
   "@type": "owl:DatatypeProperty",
   "rdfs_subPropertyOf": "skos:note",
   "rdfs_label": {
    "fr": "réserve sur la mesure",
    "en": "measurement caveat"
   },
   "rdfs_comment": {
    "fr": "Phrase fixe : les régions restent perceptives ; une mesure ne les définit pas.",
    "en": "Fixed sentence: the regions remain perceptual; a measurement does not define them."
   },
   "rdfs_domain": "skos:Concept",
   "rdfs_range": "rdf:langString"
  },
  {
   "@id": "ppp:associatedMeasure",
   "@type": "owl:ObjectProperty",
   "rdfs_label": {
    "fr": "mesure associée",
    "en": "associated measurement"
   },
