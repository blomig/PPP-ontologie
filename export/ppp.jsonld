  {
   "@id": "https://w3id.org/ppp/saturation/mesure/cie015",
   "@type": "ppp:AssociatedMeasure",
   "rdfs_label": {
    "fr": "chroma C*ab (CIELAB)",
    "en": "chroma C*ab (CIELAB)"
   },
   "quantity": {
    "fr": "chroma calculé à partir des coordonnées a* et b*, elles-mêmes calculées sur des valeurs trichromatiques mesurées",
    "en": "chroma computed from the a* and b* coordinates, themselves computed from measured tristimulus values"
   },
   "unitOrScale": {
    "fr": "C*ab, à partir de 0 pour un gris (corrélat approché du chroma, e-ILV 17-23-076)",
    "en": "C*ab, from 0 for a grey (approximate correlate of chroma, e-ILV 17-23-076)"
   },
   "gap": {
    "fr": "corrélat approché du chroma, que la CIE distingue de la saturation : le chroma se juge par rapport à un blanc ou un gris éclairé de même (e-ILV 17-22-074), la saturation par rapport à la luminosité propre de la zone (e-ILV 17-22-073) ; valeur calculée pour un observateur et un illuminant de référence, sur un échantillon isolé : ne tient compte ni de l’entourage ni de l’éclairage de l’épisode",
    "en": "an approximate correlate of chroma, which the CIE distinguishes from saturation: chroma is judged relative to a similarly illuminated white or grey (e-ILV 17-22-074), saturation relative to the area’s own brightness (e-ILV 17-22-073); a value computed for a reference observer and illuminant, on an isolated sample: it takes into account neither the surround nor the lighting of the episode"
   },
   "measurementConditions": {
    "fr": "géométries d’éclairage et d’observation, observateur et illuminant normalisés",
    "en": "standardised illumination and viewing geometries, observer and illuminant"
   },
   "proximity": "https://w3id.org/ppp/mesure/proximite/proche",
   "dct:bibliographicCitation": [
    "CIE (2018). CIE 015:2018 Colorimetry, 4th Edition. Vienne : Commission Internationale de l'Éclairage.",
    "CIE S 017:2020, ILV : International Lighting Vocabulary, 2e éd., entrée 17-23-076 « CIE 1976 L*a*b* colour space ». Vienne : CIE (accès libre en ligne, e-ILV).",
    "CIE S 017:2020, ILV : International Lighting Vocabulary, 2e éd., entrée 17-22-074 « chroma ». Vienne : CIE.",
    "CIE S 017:2020, ILV : International Lighting Vocabulary, 2e éd., entrée 17-22-073 « saturation ». Vienne : CIE."
   ]
  },
  {
   "@id": "https://w3id.org/ppp/saturation/mesure/astm_d1535",
