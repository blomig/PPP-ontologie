   },
   "example": {
    "fr": "la lumière passe, mais on ne distingue pas les formes derrière (un verre dépoli, un abat-jour en papier)",
    "en": "light passes, but the shapes behind cannot be made out (frosted glass, a paper lampshade)"
   },
   "regionOf": "https://w3id.org/ppp/translucency",
   "broader": "https://w3id.org/ppp/translucency"
  },
  {
