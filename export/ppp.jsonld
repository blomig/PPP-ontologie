  {
   "@id": "https://w3id.org/ppp/curvature/mesure/iso_80000_3",
   "@type": "ppp:AssociatedMeasure",
   "rdfs_label": {
    "fr": "courbure géométrique",
    "en": "geometric curvature"
   },
   "quantity": {
    "fr": "inverse du rayon du cercle osculateur, en un point d’une courbe plane",
    "en": "inverse of the radius of the osculating circle, at a point of a plane curve"
   },
   "unitOrScale": {
    "fr": "m⁻¹ (rayon de courbure en mètres)",
    "en": "m⁻¹ (radius of curvature in metres)"
   },
   "gap": {
    "fr": "ISO 80000-3 définit la grandeur sans décrire de procédé de mesure : la valeur dépend de la façon dont le tracé est relevé et lissé ; la courbure perçue dépend aussi de la distance de vue et de l’observateur ; définie seulement pour une courbe au moins deux fois dérivable, donc ni pour un angle ni pour un tracé brisé ; au toucher, ne saisit ni le geste ni la partie de la main",
    "en": "ISO 80000-3 defines the quantity without describing a measurement procedure: the value depends on how the trace is measured and smoothed; perceived curvature also depends on viewing distance and on the observer; defined only for a curve at least twice differentiable, so neither for a corner nor for a broken line; by touch, it captures neither the movement nor the part of the hand"
   },
   "measurementConditions": {
    "fr": "tracé relevé (coordonnées) d’un bord ou d’une coupe de surface ; courbe plane lissée",
    "en": "measured trace (coordinates) of an edge or of a section of a surface; smoothed plane curve"
   },
   "proximity": "https://w3id.org/ppp/mesure/proximite/indirecte",
   "dct:bibliographicCitation": "ISO 80000-3:2019. Quantities and units — Part 3: Space and time. Genève : ISO."
  },
