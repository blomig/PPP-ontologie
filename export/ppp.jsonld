    "https://w3id.org/ppp/hue/orange",
    "https://w3id.org/ppp/hue/yellow",
    "https://w3id.org/ppp/hue/green",
    "https://w3id.org/ppp/hue/blue",
    "https://w3id.org/ppp/hue/purple"
   ]
