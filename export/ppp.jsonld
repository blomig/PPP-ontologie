   "skos:notation": "marked",
   "prefLabel": {
    "fr": "décalage de niveau au joint : marqué",
    "en": "joint level offset: marked"
   },
   "hiddenLabel": {
    "fr": "marqué",
    "en": "marked"
   },
   "example": {
    "fr": "une différence de niveau visible à distance d’examen",
    "en": "a difference in level visible at examination distance"
   },
   "regionOf": "https://w3id.org/ppp/jointLevelOffset",
   "broader": "https://w3id.org/ppp/jointLevelOffset"
