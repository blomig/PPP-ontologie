   },
   "hiddenLabel": {
    "fr": "maximal",
    "en": "maximal"
   },
   "example": {
    "fr": "une zone très sombre contre une zone très claire (noir sur blanc)",
    "en": "a very dark area against a very light area (black on white)"
   },
