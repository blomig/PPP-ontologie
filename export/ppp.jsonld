  {
   "@id": "https://w3id.org/ppp/hueRange/mesure/cie_ilv_cielab",
   "@type": "ppp:AssociatedMeasure",
   "rdfs_label": {
    "fr": "étendue des valeurs de l’angle de teinte hab mesurées",
    "en": "range of the measured hue angle hab values"
   },
   "quantity": {
    "fr": "écart entre la plus faible et la plus forte valeur de l’angle de teinte hab parmi les zones mesurées",
    "en": "gap between the lowest and the highest value of hue angle hab among the measured areas"
   },
   "unitOrScale": {
    "fr": "degrés d’angle de teinte (e-ILV 17-23-076)",
    "en": "degrees of hue angle (e-ILV 17-23-076)"
   },
   "gap": {
    "fr": "calcul sur des valeurs ponctuelles, sans norme pour le choix des zones ; ne saisit ni l’observateur, ni l’éclairage de l’épisode, ni la distance, qui décident des zones qu’on distingue et de leur teinte ; l’angle est mal défini pour les zones grises ; l’angle étant circulaire, l’écart entre plus petite et plus grande valeur est faux de part et d’autre de 0°/360°",
    "en": "a calculation on point values, with no standard for the choice of areas; it captures neither the observer, nor the lighting of the episode, nor the distance, which decide which areas are told apart and their hue; the angle is poorly defined for grey areas; since the angle is circular, the gap between lowest and highest values is wrong across 0°/360°"
   },
   "measurementConditions": {
    "fr": "image colorimétrique calibrée ou mesures de plusieurs zones, observateur et illuminant normalisés",
    "en": "calibrated colorimetric image or measurements of several areas, standardised observer and illuminant"
   },
