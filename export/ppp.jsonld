   },
   "hiddenLabel": {
    "fr": "évident",
    "en": "evident"
   },
   "example": {
    "fr": "écart visible d’emblée (un gris foncé sur un fond clair)",
    "en": "a difference visible at once (a dark grey on a light background)"
   },
