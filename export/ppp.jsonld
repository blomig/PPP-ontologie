  {
   "@id": "https://w3id.org/ppp/perceptualContrast",
   "narrower": [
    "https://w3id.org/ppp/hueContrast",
    "https://w3id.org/ppp/lightnessContrast",
    "https://w3id.org/ppp/perceptualContrast/weak",
