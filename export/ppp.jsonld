  {
   "@id": "https://w3id.org/ppp/hue/mesure/cie015",
   "@type": "ppp:AssociatedMeasure",
   "rdfs_label": {
    "fr": "angle de teinte hab (CIELAB)",
    "en": "hue angle hab (CIELAB)"
   },
   "quantity": {
    "fr": "angle calculé à partir des coordonnées a* et b*, elles-mêmes calculées sur des valeurs trichromatiques mesurées",
    "en": "angle computed from the a* and b* coordinates, themselves computed from measured tristimulus values"
   },
   "unitOrScale": {
    "fr": "angle de teinte hab = arctan(b*/a*) (définition de la CIE, e-ILV 17-23-076)",
    "en": "hue angle hab = arctan(b*/a*) (CIE definition, e-ILV 17-23-076)"
   },
   "gap": {
    "fr": "un angle continu, là où le type a six régions nommées ; valeur calculée pour un observateur et un illuminant de référence, sur un échantillon isolé : ne tient compte ni de l’entourage ni de l’éclairage de l’épisode",
    "en": "a continuous angle, where the type has six named regions; a value computed for a reference observer and illuminant, on an isolated sample: it takes into account neither the surround nor the lighting of the episode"
   },
   "measurementConditions": {
    "fr": "géométries d’éclairage et d’observation, observateur et illuminant normalisés",
    "en": "standardised illumination and viewing geometries, observer and illuminant"
   },
   "proximity": "https://w3id.org/ppp/mesure/proximite/proche",
   "dct:bibliographicCitation": [
    "CIE (2018). CIE 015:2018 Colorimetry, 4th Edition. Vienne : Commission Internationale de l'Éclairage.",
    "CIE S 017:2020, ILV : International Lighting Vocabulary, 2e éd., entrée 17-23-076 « CIE 1976 L*a*b* colour space ». Vienne : CIE (accès libre en ligne, e-ILV)."
   ]
  },
  {
   "@id": "https://w3id.org/ppp/hue/mesure/astm_d1535",
