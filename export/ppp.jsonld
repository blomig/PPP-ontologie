    "fr": "unité ou échelle",
    "en": "unit or scale"
   },
   "rdfs_comment": {
    "fr": "Unité ou échelle de la mesure.",
    "en": "Unit or scale of the measurement."
   },
   "rdfs_domain": "ppp:AssociatedMeasure",
   "rdfs_range": "rdf:langString"
  },
  {
   "@id": "ppp:proximity",
   "@type": "owl:ObjectProperty",
   "rdfs_label": {
    "fr": "proximité",
    "en": "closeness"
   },
   "rdfs_comment": {
    "fr": "Proximité de la mesure au type.",
    "en": "Closeness of the measurement to the type."
   },
   "rdfs_domain": "ppp:AssociatedMeasure",
   "rdfs_range": "ppp:Proximity"
  },
  {
