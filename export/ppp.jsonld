   "@type": "ppp:AssociatedMeasure",
   "rdfs_label": {
    "fr": "différence de niveau au joint",
    "en": "level difference at the joint"
   },
   "quantity": {
    "fr": "distance entre les plans des deux surfaces, mesurée perpendiculairement à elles, à l’endroit du joint",
    "en": "distance between the planes of the two surfaces, measured perpendicular to them, at the joint"
   },
   "unitOrScale": {
    "fr": "millimètres",
    "en": "millimetres"
   },
   "gap": {
    "fr": "ISO 80000-3 définit la grandeur sans décrire de procédé de mesure ; aucune norme de pose n’a été lue ; une lumière rasante révèle une petite différence qu’un éclairage de face cache ; ne saisit ni la distance de vue, ni l’observateur, ni, au toucher, le geste",
    "en": "ISO 80000-3 defines the quantity without describing a measurement procedure; no installation standard has been read; raking light reveals a small difference that frontal lighting hides; it captures neither the viewing distance, nor the observer, nor, by touch, the movement of the hand"
   },
   "measurementConditions": {
