    "fr": "conditions de mesure",
    "en": "measurement conditions"
   },
   "rdfs_comment": {
    "fr": "Conditions de la mesure.",
    "en": "Conditions of the measurement."
   },
   "rdfs_domain": "ppp:AssociatedMeasure",
   "rdfs_range": "rdf:langString"
  },
  {
