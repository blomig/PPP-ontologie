   "rdfs_label": {
    "fr": "mesure non retenue",
    "en": "measurement not retained"
   },
   "rdfs_comment": {
    "fr": "Relie un type à une méthode examinée et non retenue.",
    "en": "Links a type to a method examined and not retained."
   },
   "rdfs_domain": "skos:Concept",
   "rdfs_range": "ppp:NotRetainedMeasure"
  },
