    "https://w3id.org/ppp/textureDirectionality/partlyOriented",
    "https://w3id.org/ppp/textureDirectionality/oriented"
   ]
  },
  {
   "@id": "https://w3id.org/ppp/textureDirectionality/nonOriented",
   "@type": "skos:Concept",
   "inScheme": "https://w3id.org/ppp/",
   "skos:notation": "nonOriented",
   "prefLabel": {
    "fr": "orientation de la texture : sans orientation",
    "en": "direction of the texture: non-oriented"
   },
   "hiddenLabel": {
    "fr": "sans orientation",
    "en": "non-oriented"
   },
   "example": {
    "fr": "aucune direction ne se dégage (un crépi projeté, du papier de verre)",
    "en": "no direction emerges (a sprayed roughcast, sandpaper)"
   },
   "regionOf": "https://w3id.org/ppp/textureDirectionality",
   "broader": "https://w3id.org/ppp/textureDirectionality"
  },
  {
   "@id": "https://w3id.org/ppp/textureDirectionality/partlyOriented",
   "@type": "skos:Concept",
   "inScheme": "https://w3id.org/ppp/",
   "skos:notation": "partlyOriented",
   "prefLabel": {
    "fr": "orientation de la texture : en partie orientée",
    "en": "direction of the texture: partly oriented"
   },
   "hiddenLabel": {
    "fr": "en partie orientée",
    "en": "partly oriented"
   },
   "example": {
    "fr": "une direction se dégage par endroits (des coups de pinceau en relief qui suivent à peu près le même sens)",
    "en": "a direction emerges in places (raised brushstrokes that run roughly the same way)"
   },
   "regionOf": "https://w3id.org/ppp/textureDirectionality",
   "broader": "https://w3id.org/ppp/textureDirectionality"
  },
  {
