  {
   "@id": "https://w3id.org/ppp/symmetry/mesure/zabrodsky1995",
   "@type": "ppp:AssociatedMeasure",
   "rdfs_label": {
    "fr": "distance de symétrie",
    "en": "symmetry distance"
   },
   "quantity": {
    "fr": "plus petit déplacement quadratique moyen des points d’une forme pour obtenir une forme symétrique",
    "en": "smallest mean squared displacement of the points of a shape needed to obtain a symmetric shape"
   },
   "unitOrScale": {
    "fr": "distance sans dimension (forme normalisée par sa taille)",
    "en": "dimensionless distance (shape normalised by its size)"
   },
   "gap": {
    "fr": "géométrique : elle dépend des points relevés et de leur appariement, choisis par l’opérateur, et ne saisit ni l’orientation de l’axe par rapport à l’observateur, ni la distance de vue, ni l’éclairage, ni l’observateur ; méthode de recherche, non normalisée",
    "en": "geometric: it depends on the measured points and on how they are paired, chosen by the operator, and captures neither the orientation of the axis relative to the observer, nor the viewing distance, nor the lighting, nor the observer; research method, not standardised"
   },
   "measurementConditions": {
    "fr": "points ou contour relevés sur la forme ou son image ; type de symétrie (miroir, rotation) choisi",
    "en": "points or contour measured on the shape or its image; type of symmetry (mirror, rotation) chosen"
   },
   "proximity": "https://w3id.org/ppp/mesure/proximite/indirecte",
   "dct:bibliographicCitation": "Zabrodsky, H., Peleg, S. & Avnir, D. (1995). Symmetry as a continuous feature. IEEE Transactions on Pattern Analysis and Machine Intelligence, 17(12), 1154–1166."
  },
  {
   "@id": "https://w3id.org/ppp/symmetry/echelle",
