  {
   "@id": "https://w3id.org/ppp/lightnessContrast/mesure/cie_ilv_cielab",
   "@type": "ppp:AssociatedMeasure",
   "rdfs_label": {
    "fr": "écart de clarté L* entre deux zones",
    "en": "lightness gap L* between two areas"
   },
   "quantity": {
    "fr": "différence entre les clartés L* calculées pour chaque zone (CIELAB)",
    "en": "difference between the lightnesses L* computed for each area (CIELAB)"
   },
   "unitOrScale": {
    "fr": "unités L* (0 pour le noir, 100 pour le blanc de référence, e-ILV 17-23-076)",
    "en": "L* units (0 for black, 100 for the reference white, e-ILV 17-23-076)"
   },
   "gap": {
    "fr": "compare deux valeurs calculées pour un observateur et un illuminant de référence, sur des échantillons isolés ; ne saisit ni l’entourage, ni l’éclairage de l’épisode, ni la distance entre les zones, qui changent la clarté perçue de chacune",
    "en": "compares two values computed for a reference observer and illuminant, on isolated samples; it captures neither the surround, nor the lighting of the episode, nor the distance between the areas, which change the perceived lightness of each"
   },
   "measurementConditions": {
    "fr": "géométries d’éclairage et d’observation, observateur et illuminant normalisés, pour chacune des deux zones",
    "en": "standardised illumination and viewing geometries, observer and illuminant, for each of the two areas"
   },
   "proximity": "https://w3id.org/ppp/mesure/proximite/proche",
   "dct:bibliographicCitation": [
    "CIE S 017:2020, ILV : International Lighting Vocabulary, 2e éd., entrée 17-23-076 « CIE 1976 L*a*b* colour space ». Vienne : CIE (accès libre en ligne, e-ILV).",
    "CIE (2018). CIE 015:2018 Colorimetry, 4th Edition. Vienne : Commission Internationale de l'Éclairage."
   ]
  },
  {
   "@id": "https://w3id.org/ppp/lightnessContrast/mesure/peli1990",
   "@type": "ppp:AssociatedMeasure",
   "rdfs_label": {
    "fr": "contraste de luminance",
    "en": "luminance contrast"
   },
   "quantity": {
    "fr": "contraste de luminance, calculé à partir des luminances de deux plages ou, localement, sur une image",
    "en": "luminance contrast, computed from the luminances of two patches or, locally, on an image"
   },
   "unitOrScale": {
    "fr": "nombre sans dimension",
    "en": "dimensionless number"
   },
   "gap": {
    "fr": "porte sur la luminance, pas sur la clarté perçue ; bien défini et en accord avec le contraste perçu pour des images simples (réseau, plage sur fond uniforme), pas pour des images complexes ; ne saisit ni l’observateur, ni l’entourage, ni la distance",
    "en": "concerns luminance, not perceived lightness; well defined and in agreement with perceived contrast for simple images (grating, patch on a uniform background), not for complex images; it captures neither the observer, nor the surround, nor the distance"
   },
   "measurementConditions": {
    "fr": "luminances mesurées (luminancemètre ou image calibrée) ; image simple",
    "en": "measured luminances (luminance meter or calibrated image); simple image"
   },
   "proximity": "https://w3id.org/ppp/mesure/proximite/indirecte",
   "dct:bibliographicCitation": "Peli, E. (1990). Contrast in complex images. Journal of the Optical Society of America A, 7(10), 2032–2040."
  },
  {
   "@id": "https://w3id.org/ppp/lightnessContrast/mesure/non-retenue-1",
   "@type": "ppp:NotRetainedMeasure",
   "rdfs_label": {
    "fr": "différence de couleur ΔE*ab (CIELAB)",
    "en": "colour difference ΔE*ab (CIELAB)"
   },
   "reason": {
    "fr": "différence globale de couleur (distance euclidienne dans CIELAB), qui mêle la clarté, le chroma et la teinte : elle ne sépare pas la qualité que juge ce type",
    "en": "an overall colour difference (Euclidean distance in CIELAB), which mixes lightness, chroma and hue: it does not isolate the quality this type judges"
   },
   "dct:bibliographicCitation": "CIE S 017:2020, ILV : International Lighting Vocabulary, 2e éd., entrée 17-23-077 « CIE 1976 L*a*b* colour difference ». Vienne : CIE (accès libre en ligne, e-ILV)."
  },
  {
   "@id": "https://w3id.org/ppp/lightnessContrast/mesure/non-retenue-2",
   "@type": "ppp:NotRetainedMeasure",
   "rdfs_label": {
    "fr": "calcul des tolérances et petites différences de couleur (ASTM D2244)",
    "en": "calculation of colour tolerances and small colour differences (ASTM D2244)"
   },
   "reason": {
    "fr": "pratique conçue pour des tolérances et de petites différences entre éprouvettes opaques comparées côte à côte, alors que le type va jusqu’aux différences les plus fortes ; la norme note elle-même que la proximité des éprouvettes, le brillant et la texture changent le lien entre différence mesurée et acceptabilité",
    "en": "a practice designed for tolerances and small differences between opaque specimens compared side by side, whereas the type extends to the strongest differences; the standard itself notes that specimen proximity, gloss and texture change the relation between measured difference and acceptability"
   },
   "dct:bibliographicCitation": "ASTM D2244-23. Standard Practice for Calculation of Color Tolerances and Color Differences from Instrumentally Measured Color Coordinates. ASTM International."
  },
  {
   "@id": "https://w3id.org/ppp/lightnessContrast/echelle",
   "@type": "skos:OrderedCollection",
   "prefLabel": {
    "fr": "échelle de « contraste de clarté »",
    "en": "scale of “lightness contrast”"
   },
   "memberList": [
    "https://w3id.org/ppp/lightnessContrast/weak",
    "https://w3id.org/ppp/lightnessContrast/moderate",
    "https://w3id.org/ppp/lightnessContrast/marked",
    "https://w3id.org/ppp/lightnessContrast/strong"
   ]
  },
  {
   "@id": "https://w3id.org/ppp/lightnessContrast/weak",
