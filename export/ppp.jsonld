  {
   "@id": "https://w3id.org/ppp/surfaceGloss/mesure/iso2813",
   "@type": "ppp:AssociatedMeasure",
   "rdfs_label": {
    "fr": "brillance spéculaire (brillancemètre)",
    "en": "specular gloss (glossmeter)"
   },
   "quantity": {
    "fr": "lumière renvoyée dans la direction spéculaire, rapportée à un étalon",
    "en": "light reflected in the specular direction, relative to a standard"
   },
   "unitOrScale": {
    "fr": "unités de brillance (GU), géométries 20°, 60° et 85°",
    "en": "gloss units (GU), 20°, 60° and 85° geometries"
   },
   "gap": {
    "fr": "mesure la quantité de lumière renvoyée dans une direction, pas la netteté des reflets ; ASTM D523 note que peu de résultats publiés relient les intervalles mesurés aux intervalles perçus, tout en signalant un bon accord avec les classements visuels pour des revêtements (section 5.3)",
    "en": "measures the amount of light reflected in one direction, not the sharpness of reflections; ASTM D523 notes that little has been published on how measured intervals relate to perceived ones, while reporting good agreement with visual scaling for coated specimens (section 5.3)"
   },
   "measurementConditions": {
    "fr": "revêtement non texturé sur substrat plan et opaque ; angle fixé par la norme",
    "en": "non-textured coating on a flat, opaque substrate; angle set by the standard"
   },
   "proximity": "https://w3id.org/ppp/mesure/proximite/proche",
   "dct:bibliographicCitation": [
    "ISO 2813:2014. Paints and varnishes — Determination of gloss value at 20°, 60° and 85°. Genève : ISO.",
    "ASTM D523-14(2018). Standard Test Method for Specular Gloss. ASTM International."
   ]
  },
  {
   "@id": "https://w3id.org/ppp/surfaceGloss/mesure/astm_d5767",
   "@type": "ppp:AssociatedMeasure",
   "rdfs_label": {
    "fr": "netteté de l’image réfléchie (distinctness of image, DOI)",
    "en": "distinctness of reflected image (DOI)"
   },
   "quantity": {
    "fr": "netteté de l’image d’une fente réfléchie par la surface",
    "en": "sharpness of the image of a slit reflected by the surface"
   },
   "unitOrScale": {
    "fr": "valeur de netteté d’image, de 0 à 100 (100 : netteté parfaite, ASTM D5767 section 4.5)",
    "en": "image clarity value, 0 to 100 (100: perfect DOI, ASTM D5767 section 4.5)"
   },
   "gap": {
    "fr": "mesure la netteté de l’image réfléchie, que la brillance spéculaire ne note pas de façon satisfaisante (ASTM D5767 section 4.2) ; ne vaut que pour des surfaces très brillantes et planes : ASTM E430 la dit inadaptée aux finitions diffuses (section 1.1)",
    "en": "measures the sharpness of the reflected image, which specular gloss does not rate satisfactorily (ASTM D5767 section 4.2); valid only for flat, high-gloss surfaces: ASTM E430 says it is not suitable for diffuse finishes (section 1.1)"
   },
   "measurementConditions": {
    "fr": "surfaces planes ou rendues planes ; revêtements (D5767) ; surfaces très brillantes, 20° ou 30° (E430)",
    "en": "flat or flattenable surfaces; coatings (D5767); high-gloss surfaces, 20° or 30° (E430)"
   },
   "proximity": "https://w3id.org/ppp/mesure/proximite/proche",
   "dct:bibliographicCitation": [
    "ASTM D5767-18. Standard Test Method for Instrumental Measurement of Distinctness-of-Image (DOI) Gloss of Coated Surfaces. ASTM International.",
    "ASTM E430-19. Standard Test Methods for Measurement of Gloss of High-Gloss Surfaces by Abridged Goniophotometry. ASTM International."
   ]
  },
